{
  "name": "papyrus-backend",
  "version": "2.0.2",
  "description": "Papyrus Desktop TypeScript backend",
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc && node scripts/postbuild.js",
    "start": "node dist/api/server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.4",
    "async-mutex": "^0.5.0",
    "chokidar": "^4.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.3",
    "openai": "^7.45.1",
    "sharp": "^0.35.5",
    "tar": "^7.5.22",
    "undici": "^8.12.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
